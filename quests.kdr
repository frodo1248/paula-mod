// PAULA - HITCHHIKER QUESTS

// Single quest, given when Paula is picked up
{
	quest_name: paula_lawyer_trip
	quest_title: "A Lawyer for Emma"
	quest_desc: "Paula wants to see a lawyer to fight for custody of her daughter. Help her get ready and take her to him."
	quest_type: hh
	quest_days: 20

	obj: food
	obj_type: item_tag
	obj_item_tag: food
	obj_dest: none
	obj_title: "Get Paula some food"
	obj_desc: "She hasn't eaten all day. Anything edible will do."

	obj: drink
	obj_type: item_tag
	obj_item_tag: beverage
	obj_dest: none
	obj_title: "Get Paula a drink"
	obj_desc: "She's very nervous. Any drink will do."

	obj: go_to_lawyer
	obj_type: dest
	obj_dest: hidden
	obj_new_dest_id: city_east
	obj_title: "Take Paula to the lawyer"
	obj_desc: "Go with her to the big city out east to start her case."

	dialogue_turn_in_complete: paula_lawyer_trip_complete

	reward: money:50,skill_point:1
}
