// PAULA - HITCHHIKER QUESTS

// Single quest, given when Paula is picked up
{
	quest_name: paula_lawyer_trip
	quest_title: "Un abogado para Emma"
	quest_desc: "Paula quiere consultar a un abogado para luchar por la custodia de su hija. Ayúdala a prepararse y llévala hasta él."
	quest_type: hh
	quest_days: 20

	obj: food
	obj_type: item_tag
	obj_item_tag: food
	obj_dest: none
	obj_title: "Conseguir comida para Paula"
	obj_desc: "No comió en todo el día. Cualquier cosa de comer sirve."

	obj: drink
	obj_type: item_tag
	obj_item_tag: beverage
	obj_dest: none
	obj_title: "Conseguir una bebida para Paula"
	obj_desc: "Está muy nerviosa. Cualquier bebida sirve."

	obj: go_to_lawyer
	obj_type: dest
	obj_dest: hidden
	obj_new_dest_id: city_east
	obj_title: "Llevar a Paula con el abogado"
	obj_desc: "Acompáñala a la gran ciudad del este para iniciar su caso."

	dialogue_turn_in_complete: paula_lawyer_trip_complete

	reward: money:50,skill_point:1
}
